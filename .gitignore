# ── BERKAS GAME ASLI — TIDAK DIDISTRIBUSIKAN ───────────────────────────────
# Creative Contraptions (c) 1985 Bantam Electronic Publishing.
# Repo ini berisi KODE dan ANALISIS saja. Pengguna menyediakan salinan game
# miliknya sendiri; lihat README untuk cara menaruhnya.
Creative-Contraptions/
_ORIGINAL_READONLY/
Creative-Contraptions_DOS_EN.zip
# biner ter-unpack = turunan langsung dari EXE game -> ikut dikecualikan,
# TAPI konfigurasi UNP-nya disimpan supaya proses unpack bisa diulang.
work/unpack/*
!work/unpack/unp.conf

# bundel aset milik port (salinan berkas game) — dibuat oleh:
#     python port/import_assets.py
port/cc/data/

# salinan berkas game yang menumpang di work/
work/ANIMATE
work/GRAPH
work/MECHS
work/MISC
work/CONTRAP
work/CONTRAP.EXE
work/BANTAM.EXE
work/BANTLOGO.EXE
work/LGLOGO.EXE
work/BLOGO.CMP
work/LG.CMP
work/MODE.COM
work/DESC.SDI
work/SETUP1.BAT
work/SETUP2.BAT
work/file_id.diz

# ── Keluaran build rekonstruksi C ──────────────────────────────────────────
src_c/out/
src_c/build/dos/
src_c/build/_gen.conf

# ── Perkakas pihak ketiga (~2,1 GB) ────────────────────────────────────────
# DOSBox-X, Ghidra, JDK, UNP. Diunduh sendiri, bukan bagian dari proyek.
tools/

# ── Cache Python ───────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Proyek Ghidra (bisa dibangun ulang dari work/unpack/CONTRAP_UNPACKED.EXE) ──
work/ghidra_proj/

# ── Frame mentah hasil capture emulator ────────────────────────────────────
# ~16 MB / 3.600 file, semuanya BISA DIBUAT ULANG lewat:
#   VARIANT=n VCAP=1 python work/emu.py <goal> <mode>
# Hasil akhirnya sudah dipak ke port/cc/anim/*.dat yang IKUT diversikan.
work/vframes*/
work/frames/
work/playframes/
work/caps/
work/caps_goals/

# ── Dump aset hasil decode (bisa dibuat ulang dari GRAPH/MECHS/MISC) ───────
work/assets/

# ── Sementara ──────────────────────────────────────────────────────────────
*.tmp
*.log

# konfigurasi DOSBox-X yang DIBANGKITKAN tiap build (compile/link/probe)
src_c/build/_*.conf

# Keluaran emu.py saat menjalankan EXE REKONSTRUKSI (bukan ground truth).
work/emu_caps_recon/
work/emu_caps_ref/

# tangkapan layar port (--shots), produk turunan
port/scr_*.png
work/obs_menu/
work/animseq/
work/palseq/
work/playseq/
work/prseq/
work/dostest/
work/suaraseq/

# tangkapan harness animasi jalur bermain (bisa dibangkitkan ulang)
work/animmainseq/
